{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GPTVoice",
  "version": "0.1.2",
  "identifier": "com.gptvoice.desktop.tauri",
  "build": {
    "frontendDist": "../tauri-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "GPTVoice",
        "width": 1040,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/gptvoice.ico"
    ]
  }
}
